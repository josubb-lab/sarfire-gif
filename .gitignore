# ============================================
# .gitignore para SARFIRE-GIF
# Proyecto: Clasificación de Grandes Incendios Forestales
# Stack: Python, XGBoost, SHAP, Pandas
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Entornos virtuales ---
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# --- IDEs y editores ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# DATOS (CRÍTICO - Archivos grandes)
# ============================================

# Datos crudos de Civio
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.json
data/raw/*.zip
data/raw/*.gz

# Datos procesados
data/processed/*.csv
data/processed/*.parquet
data/processed/*.feather
data/processed/*.pkl

# Datos externos (AEMET, etc.)
data/external/*.csv
data/external/*.json
data/external/*.xml

# IMPORTANTE: Mantener estructura de carpetas
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# ============================================
# MODELOS ENTRENADOS (Archivos grandes)
# ============================================

# Modelos serializados
models/*.pkl
models/*.joblib
models/*.h5
models/*.hdf5
models/*.pb
*.onnx
*.pt
*.pth

# Checkpoints de entrenamiento
models/checkpoints/

# EXCEPCIÓN: Permitir modelos demo pequeños (<10MB)
!models/demo_*.joblib
!models/.gitkeep

# ============================================
# OUTPUTS Y REPORTES
# ============================================

# Gráficos temporales
reports/figures/temp_*.png
reports/figures/*.jpg
reports/figures/*.jpeg

# Métricas temporales
reports/metrics/temp_*.json
reports/metrics/*.csv

# ============================================
# MLFLOW (si se usa)
# ============================================
mlruns/
mlartifacts/
.mlflow/

# ============================================
# SEGURIDAD (CRÍTICO - API Keys)
# ============================================

# Variables de entorno
.env
.env.local
.env.production
.env.development

# Archivos de secrets
secrets.yaml
secrets.json
api_keys.txt
*.key
*.pem
credentials.json

# ============================================
# TEMPORALES Y CACHE
# ============================================

# Cache de Python
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Temporales del sistema
*.tmp
*.temp
.DS_Store
Thumbs.db

# Outputs temporales
outputs/temp/
temp/
tmp/

# ============================================
# NOTEBOOKS (Solo checkpoints)
# ============================================
# Nota: Los notebooks SÍ se suben (muestran trabajo)
# Solo ignoramos checkpoints y outputs grandes

notebooks/.ipynb_checkpoints/
notebooks/temp_*.ipynb

# ============================================
# OTROS
# ============================================

# Archivos de sistema
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
*.Identifier

# Backups
*.bak
*.backup
*~
